# Local runtime baseline: PHP 8.3+, Node.js 22.12+, and pnpm 11.16.0.
# CI uses PHP 8.4. See docs/ENVIRONMENT.md for setup and production guidance.
# Recommended php.ini upload baseline: 25M files, 32M requests, 512M memory.
MALWARE_SCANNER_DRIVER=none
MALWARE_SCANNER_EXECUTABLE=clamdscan
MALWARE_SCANNER_ARGUMENTS=--fdpass,--no-summary
MALWARE_SCANNER_TIMEOUT=30
MALWARE_SCANNER_CALLBACK=
CLAMAV_SIGNATURE_PATHS=/var/lib/clamav/daily.cld,/var/lib/clamav/daily.cvd
CLAMAV_SIGNATURE_MAX_AGE_SECONDS=172800
UPLOAD_RATE_LIMIT_PER_MINUTE=20
UPLOAD_PROJECT_QUOTA_BYTES=10737418240
UPLOAD_USER_PROJECT_QUOTA_BYTES=2147483648
UPLOAD_PROJECT_FILE_LIMIT=10000
UPLOAD_ORPHAN_RETENTION_HOURS=72
BACKUP_RESTORE_NONCE_TTL=600
BACKUP_RESTORE_ATTEMPTS=3

APP_NAME="Project Desk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_RELEASE_SHA=

APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=Africa/Tripoli
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The supported v1 deployment is one Linux application host with private local
# storage and SQLite WAL. PostgreSQL/MySQL require a separate backup adapter.
DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_TRANSACTION_MODE=IMMEDIATE
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS baseline:
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=7500

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CSV_MAX_FILE_KB=10240
XLSX_MAX_FILE_KB=10240
XLSX_MAX_UNCOMPRESSED_MB=100
XLSX_MAX_ARCHIVE_ENTRIES=2000
CSV_MAX_ROWS=5000
BACKUP_MAX_FILE_KB=524288
# Maximum decrypted archive size (database + project files), entry count, and
# private file disks included in a complete backup. Keep backup files off-host.
BACKUP_MAX_EXPANDED_KB=2097152
BACKUP_MAX_ENTRIES=10000
BACKUP_DISK=local
BACKUP_FILE_DISKS=local
# Required in staging/production. Generate once with:
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Store this secret separately from backups. Rotation: put the new key here and
# retain old keys temporarily, comma-separated, in BACKUP_PREVIOUS_ENCRYPTION_KEYS.
BACKUP_ENCRYPTION_KEY=
BACKUP_PREVIOUS_ENCRYPTION_KEYS=
RCLONE_REMOTE=
MINIMUM_FREE_DISK_BYTES=5368709120
PRODUCTION_EVIDENCE_PATH=/var/lib/project-desk/production-evidence.json
# The production gate requires evidence schema v2. Thresholds are fixed in
# config/project-desk.php so a deployment cannot weaken them through .env.
UPLOAD_MAX_FILE_KB=25600

# Fully local requirement analysis. The Ollama URL is deliberately fixed to
# http://127.0.0.1:11434 in code and cannot be redirected by users.
LOCAL_AI_MODEL=qwen3:8b-q4_K_M
LOCAL_AI_FALLBACK_MODEL=qwen3:4b-instruct-2507-q4_K_M
LOCAL_AI_CONTEXT_SIZE=8192
LOCAL_AI_MAX_PAGES=300
# Set absolute paths only when Poppler/Tesseract are not available on PATH.
PDFINFO_BINARY=pdfinfo
PDFTOTEXT_BINARY=pdftotext
PDFTOPPM_BINARY=pdftoppm
TESSERACT_BINARY=tesseract
