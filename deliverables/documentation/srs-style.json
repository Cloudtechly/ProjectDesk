    {
      "para_index": 2,
      "text": "\u0648\u062b\u064a\u0642\u0629 \u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0648\u062a\u0648\u062b\u064a\u0642 \u0631\u0633\u0645\u064a",
      "style": "Normal"
    },
    {
      "para_index": 3,
      "text": "\u0643\u0631\u0627\u0633\u0629 \u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0627\u062a",
      "style": "Title"
    },
    {
      "para_index": 11,
      "text": "1. \u0627\u0644\u0645\u0642\u062f\u0645\u0629",
      "style": "Normal"
    },
    {
      "para_index": 18,
      "text": "2. \u0627\u0644\u0648\u0635\u0641 \u0627\u0644\u0639\u0627\u0645",
      "style": "Normal"
    },
    {
      "para_index": 26,
      "text": "3. \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u062d\u062f\u062f\u0629",
      "style": "Normal"
    },
    {
      "para_index": 34,
      "text": "4. \u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629",
      "style": "Normal"
    },
    {
      "para_index": 50,
      "text": "5. \u0646\u0645\u0627\u0630\u062c \u0627\u0644\u062d\u0627\u0644\u0629 \u0648\u062f\u0648\u0631\u0627\u062a \u0627\u0644\u062d\u064a\u0627\u0629",
      "style": "Normal"
    },
    {
      "para_index": 63,
      "text": "6. \u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u0644\u0642\u0628\u0648\u0644",
      "style": "Normal"
    },
    {
      "para_index": 71,
      "text": "7. \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u0633\u062a\u0628\u0639\u062f \u0648\u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0645\u062e\u0637\u0637\u0629",
      "style": "Normal"
    },
    {
      "para_index": 74,
      "text": "8. \u0627\u0644\u062a\u062a\u0628\u0639 \u0648\u0627\u0644\u062a\u062d\u0642\u0642",
      "style": "Normal"
    },
    {
      "para_index": 79,
      "text": "9. \u0627\u0644\u0641\u062c\u0648\u0627\u062a \u0648\u0627\u0644\u0645\u062e\u0627\u0637\u0631 \u0648\u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0641\u062a\u0648\u062d\u0629",
      "style": "Normal"
    },
    {
      "para_index": 80,
      "text": "\u0627\u0644\u0645\u0644\u062d\u0642 \u0623 \u2014 \u0645\u0635\u0641\u0648\u0641\u0629 \u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0645\u062e\u062a\u0635\u0631\u0629 \u0643\u0645\u0627 \u064a\u0646\u0641\u0630\u0647\u0627 \u0627\u0644\u0646\u0638\u0627\u0645",
      "style": "Normal"
    },
    {
      "para_index": 81,
      "text": "\u0627\u0644\u0645\u0644\u062d\u0642 \u0628 \u2014 \u0641\u0647\u0631\u0633 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a",
      "style": "Normal"
    },
    {
      "para_index": 82,
      "text": "\u0627\u0644\u0645\u0644\u062d\u0642 \u062c \u2014 \u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f",
      "style": "Normal"
    },
    {
      "para_index": 85,
      "text": "\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0648\u062b\u064a\u0642\u0629: \u062f\u0627\u062e\u0644\u064a \u2014 CloudTech",
      "style": "Normal"
    },
    {
      "para_index": 86,
      "text": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0648\u062b\u064a\u0642\u0629: \u0645\u0633\u0648\u062f\u0629 \u0645\u0631\u0627\u062c\u0639\u0629 \u0645\u0633\u062a\u062e\u0631\u062c\u0629 \u0645\u0646 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0641\u0639\u0644\u064a",
      "style": "Normal"
    },
    {
      "para_index": 87,
      "text": "\u0627\u0644\u0625\u0635\u062f\u0627\u0631: 1.0",
      "style": "Normal"
    },
    {
      "para_index": 88,
      "text": "\u062a\u0627\u0631\u064a\u062e \u062e\u0637 \u0627\u0644\u0623\u0633\u0627\u0633 \u0627\u0644\u062a\u062d\u0644\u064a\u0644\u064a: 12 \u0623\u063a\u0633\u0637\u0633 2026",
      "style": "Normal"
    },
