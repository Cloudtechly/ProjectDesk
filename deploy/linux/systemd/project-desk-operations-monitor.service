[Unit]
Description=Monitor Project Desk operational dependencies
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/project-desk/operations.env
ExecStart=/usr/bin/bash /var/www/project-desk/deploy/linux/scripts/operations-monitor.sh
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
