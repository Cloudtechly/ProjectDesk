[Unit]
Description=Project Desk database queue worker
After=network.target clamav-daemon.service
Requires=clamav-daemon.service

[Service]
Type=simple
User=project-desk
Group=project-desk
WorkingDirectory=/var/www/project-desk
ExecStart=/usr/bin/php artisan queue:work database --sleep=2 --tries=3 --timeout=7200 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=90
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
