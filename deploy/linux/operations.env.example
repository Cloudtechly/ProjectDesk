PROJECT_DESK_ROOT=/var/www/project-desk
PROJECT_DESK_STATUS_DIR=/var/lib/project-desk
PROJECT_DESK_URL=https://project-desk.example.com
PROJECT_DESK_DATABASE=/var/lib/project-desk/database.sqlite
PROJECT_DESK_MINIMUM_FREE_BYTES=5368709120
CLAMAV_SIGNATURE_MAX_AGE_SECONDS=172800
RCLONE_REMOTE=s3-project-desk:project-desk-production/backups
RCLONE_CONFIG_S3_PROJECT_DESK_TYPE=s3
RCLONE_CONFIG_S3_PROJECT_DESK_PROVIDER=AWS
RCLONE_CONFIG_S3_PROJECT_DESK_ENV_AUTH=true
S3_BUCKET=project-desk-production
S3_OBJECT_KEY=backups/replace-with-latest-project-desk-backup.pdesk
S3_MINIMUM_RETENTION_DAYS=35
S3_REQUIRE_ACCOUNT_PUBLIC_BLOCK=true
AWS_ACCOUNT_ID=replace-with-account-id
AWS_ACCESS_KEY_ID=replace-with-limited-access-key
AWS_SECRET_ACCESS_KEY=replace-with-limited-secret-key
