APP_ENV=production
APP_DEBUG=false
APP_URL=https://project-desk.example.com
APP_KEY=replace-with-generated-app-key
APP_RELEASE_SHA=replace-with-final-40-character-sha
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/project-desk/database.sqlite
BACKUP_ENCRYPTION_KEY=replace-with-an-independent-backup-key
MAIL_MAILER=smtp
MAIL_HOST=replace-with-mail-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-user
MAIL_PASSWORD=replace-with-mail-password
MALWARE_SCANNER_DRIVER=command
MALWARE_SCANNER_EXECUTABLE=clamdscan
MALWARE_SCANNER_ARGUMENTS=--fdpass,--no-summary
PRODUCTION_EVIDENCE_PATH=/var/lib/project-desk/production-evidence.json
